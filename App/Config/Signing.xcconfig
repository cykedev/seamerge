// How a release is signed: with the Developer ID Application certificate of
// the team below, with the Hardened Runtime and a secure timestamp, as
// notarization requires.
//
// Only Scripts/release.sh uses this file, with `xcodebuild -xcconfig`; other
// builds stay signed ad hoc. The team ID is public: it is part of every
// signature made with the certificate.

DEVELOPMENT_TEAM = 98WG4AS73L
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Developer ID Application
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
ENABLE_HARDENED_RUNTIME = YES
OTHER_CODE_SIGN_FLAGS = --timestamp
