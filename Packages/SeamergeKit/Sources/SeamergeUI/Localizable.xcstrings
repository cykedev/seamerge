{
  "sourceLanguage": "en",
  "strings": {
    "%@ added as %@": {
      "comment": "VoiceOver: a file was put in a field, such as LoginView.swift added as Base."
    },
    "%@ and %@": {
      "comment": "Two sides that share a toggle, such as feature/login and main."
    },
    "%@ removed from %@": {
      "comment": "VoiceOver: a field was emptied, such as LoginView.swift removed from Left."
    },
    "%@ removed these lines": {
      "comment": "Preview of a conflict in place of the lines a side removed, such as main."
    },
    "%@ · %@": {
      "comment": "The name of a commit followed by its branch, such as 1a2b3c4 Fix typo · main."
    },
    "%@ ↔ %@": {
      "comment": "The names of the left and the right file of a comparison, in a title or list."
    },
    "%@ ↔ %@ ↔ %@": {
      "comment": "A recent merge: the names of A, the base and B."
    },
    "%@, %@": {
      "comment": "VoiceOver: a pane, such as A, feature/login."
    },
    "%@, %@, %@": {
      "comment": "VoiceOver: a pane with its name and role in the order the header shows them, such as A, feature/login, incoming or A, your commit, 1a2b3c4 Fix typo."
    },
    "%@, in %@": {
      "comment": "VoiceOver: the file in a field, such as LoginView.swift, in ~/Projects/app."
    },
    "%@, line %lld": {
      "comment": "VoiceOver: a mark in the overview bar of the result, such as From A, line 12."
    },
    "%@. %@": {
      "comment": "VoiceOver after a decision, such as Chosen: B. 2 Conflicts Left."
    },
