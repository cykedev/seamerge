  "strings" : {
    "%@ (%@: %@)" : {
      "comment" : "Help tag of a file in the sidebar that cannot be read: its path, the state and the reason, such as Logs (Can’t Read: You don’t have permission.)."
    },
    "%@ of %@ files differ" : {
      "comment" : "Sidebar and VoiceOver: how many files of two compared folders differ, such as 12 of 340 files differ."
    },
    "“%@” can’t be saved in %@." : {
      "comment" : "Sheet: the result holds characters the encoding lacks, such as in ISO 8859-1.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” can’t be saved in %2$@."
          }
        }
      }
    },
    "“%@” is a binary file." : {
      "comment" : "Merge of a file that is not text, such as “logo.png” is a binary file."
    },
    "“%@” isn’t a text file." : {
      "comment" : "Alert: a file of a merge or comparison is binary."
    },
    "“%@” isn’t a text file. Open it in the app that made it." : {
