{
  "sourceLanguage": "en",
  "strings": {
    "%@ and %@": {
      "comment": "Two sides that share a toggle, such as feature/login and main."
    },
    "%@ · %@": {
      "comment": "The name of a commit followed by its branch, such as 1a2b3c4 Fix typo · main."
    },
    "%@, %@": {
      "comment": "VoiceOver: a pane, such as A, feature/login."
    },
    "%@, %@, %@": {
      "comment": "VoiceOver: a pane with its name and role in the order the header shows them, such as A, feature/login, incoming or A, your commit, 1a2b3c4 Fix typo."
    },
    "%@, line %lld": {
      "comment": "VoiceOver: a mark in the overview bar of the result, such as From A, line 12."
    },
    "%lld changes from A": {
      "comment": "Subtitle: the changes of the incoming side, such as 3 changes from A.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld change from A"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld changes from A"
                }
              }
            }
          }
        }
      }
    },
    "%lld from B": {
      "comment": "Subtitle: the changes of the own side after those of A, such as 5 from B."
    },
    "%lld more files with conflicts": {
      "comment": "Subtitle: how many other files of the operation still have conflicts.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld more file with conflicts"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld more files with conflicts"
                }
              }
            }
          }
        }
      }
    },
    "A": {
      "comment": "The badge of the incoming side."
    },
    "All whitespace ignored": {
      "comment": "Subtitle: the comparison ignores spaces and tabs entirely."
    },
    "Author": {
      "comment": "Details of a side: the author of the commit."
    },
    "B": {
      "comment": "The badge of the own side."
    },
    "Base": {
      "comment": "The badge of the common ancestor."
    },
    "CR": {
      "comment": "Line endings: carriage return."
    },
    "CRLF": {
      "comment": "Line endings: CR LF."
    },
    "Change in %@, line %lld": {
      "comment": "VoiceOver: a mark in the overview bar, such as Change in A, line 12."
    },
    "Commit": {
      "comment": "Details of a side: the commit."
    },
    "Compared exactly": {
      "comment": "Subtitle: the comparison counts every byte, whitespace and line endings too."
    },
    "Copy": {
      "comment": "Context menu: copy the selected text, or the block if nothing is selected."
    },
    "Copy Block": {
      "comment": "Edit menu command: copy the lines of the current block."
    },
    "Copy Path": {
      "comment": "Context menu of a header."
    },
    "Cut": {
      "comment": "Context menu: cut the selected text."
    },
    "Date": {
      "comment": "Details of a side: when the commit was made."
    },
    "Details about %@": {
      "comment": "VoiceOver: the ⓘ of a header, such as Details about A, main."
    },
    "Differs from the encoding of the other files": {
      "comment": "Help tag of the encoding in a header, shown only where it differs."
    },
    "Differs from the line endings of the other files": {
      "comment": "Help tag of the line endings in a header, shown only where they differ."
    },
    "Edited by hand": {
      "comment": "VoiceOver: a part of the result that the user typed."
    },
    "Encoding": {
      "comment": "Details of a side: UTF-8 and the like."
    },
    "Encoding: %@": {
      "comment": "VoiceOver: the encoding of the result, such as Encoding: UTF-8."
    },
    "File": {
      "comment": "Details of a side: where the file was read from."
    },
    "First Change": {
      "comment": "Go menu command."
    },
    "From %@": {
      "comment": "VoiceOver: a part of the result taken from one side, such as From A."
    },
    "From %@ and %@": {
      "comment": "VoiceOver: a part of the result taken from both sides, such as From A and B."
    },
    "From the base": {
      "comment": "VoiceOver: a part of the result taken from the common ancestor."
    },
    "Git is no longer waiting for this merge.": {
      "comment": "Notice below the result header after the Git command that asked has ended."
    },
    "Go back to the change before this one": {
      "comment": "Help tag of Previous Change."
    },
    "Go back to the open conflict before this one": {
      "comment": "Help tag of Previous Conflict."
    },
    "Go on to the change after this one": {
      "comment": "Help tag of Next Change."
    },
    "Go on to the open conflict after this one": {
      "comment": "Help tag of Next Conflict."
    },
    "ISO 8859-1": {
      "comment": "Encoding: ISO Latin 1."
    },
