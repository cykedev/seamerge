{
  "sourceLanguage": "en",
  "strings": {
    "%@ and %@": {
      "comment": "VoiceOver: the inputs that share a toggle, such as Base and B."
    },
    "%@, removes these lines": {
      "comment": "VoiceOver: a toggle that follows the inputs named in removing the lines, such as A."
    },
    "%lld Unchanged Lines": {
      "comment": "The bar that stands for unchanged lines that are hidden.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Unchanged Line"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Unchanged Lines"
                }
              }
            }
          }
        }
      }
    },
    "%lld unchanged lines in %@, collapsed": {
      "comment": "VoiceOver: the bar that stands for unchanged lines that are hidden in a pane, such as Base.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld unchanged line in %@, collapsed"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld unchanged lines in %@, collapsed"
                }
              }
            }
          }
        }
      }
    },
    "%lld unchanged lines, collapsed": {
      "comment": "VoiceOver: the bar that stands for unchanged lines that are hidden.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld unchanged line, collapsed"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld unchanged lines, collapsed"
                }
              }
            }
          }
        }
      }
    },
    "A": {
      "comment": "The name of the incoming side on a toggle."
    },
    "Added": {
      "comment": "VoiceOver: the side added lines."
    },
    "After line %lld": {
      "comment": "VoiceOver: where a mark beside a filler row is."
    },
    "Appears only on this side": {
      "comment": "Help tag of the + in the gutter."
    },
    "B": {
      "comment": "The name of the own side on a toggle."
    },
    "Base": {
      "comment": "The name of the common ancestor on a toggle."
    },
    "Before the first line": {
      "comment": "VoiceOver: where a mark beside filler rows at the start is."
    },
    "Change markers": {
      "comment": "VoiceOver: the gutter of a pane."
    },
    "Changed": {
      "comment": "VoiceOver: the side changed lines."
    },
    "Chosen: %@": {
      "comment": "VoiceOver: a block whose sources the user chose, in order, such as B, A."
    },
    "Collapse %lld Unchanged Lines": {
      "comment": "VoiceOver: the sign beside an expanded run of unchanged lines that hides them.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Collapse %lld Unchanged Line"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Collapse %lld Unchanged Lines"
                }
              }
            }
          }
        }
      }
    },
    "Collapses these unchanged lines again": {
      "comment": "Help tag of the sign beside an expanded run of unchanged lines."
    },
    "Decisions": {
      "comment": "VoiceOver: the column beside the result that shows how each block was decided."
    },
    "Differed on both sides; the result takes what you chose": {
      "comment": "Help tag of the sign of a resolved conflict."
    },
    "Differs on both sides; choose what the result takes": {
      "comment": "Help tag of the sign of an open conflict."
    },
    "Differs on this side": {
      "comment": "Help tag of the ~ in the gutter."
    },
    "Differs only in whitespace or line endings, which this comparison ignores": {
      "comment": "Help tag of the ring in the gutter."
    },
    "Edited by hand": {
      "comment": "VoiceOver: a block whose text the user typed or changed."
    },
    "Holds lines that you typed or changed": {
      "comment": "Help tag of a block whose text the user typed or changed."
    },
    "Ignored difference": {
      "comment": "VoiceOver: a line that differs only in what the comparison ignores."
    },
    "Lacks lines here that the other side has": {
      "comment": "Help tag of the − in the gutter."
    },
    "Line %lld": {
      "comment": "VoiceOver: where a mark is."
    },
    "Nothing taken": {
      "comment": "VoiceOver: a block that takes no lines from any input."
    },
    "Open conflict": {
      "comment": "VoiceOver: a conflict that still needs a decision."
    },
    "Overview": {
      "comment": "VoiceOver: the scroll bar that marks where the text changes."
    },
    "Removed": {
      "comment": "VoiceOver: the side removed lines."
    },
    "Removed text": {
      "comment": "VoiceOver: the mark where a side removed text within a line."
    },
    "Reset Block": {
      "comment": "VoiceOver: the arrow that resets a block to how it was loaded."
    },
    "Resolved conflict": {
      "comment": "VoiceOver: a conflict that has been decided."
    },
    "Return the block to how it was after loading": {
      "comment": "Help tag of the arrow that resets a block."
    },
    "Shows the hidden lines.": {
      "comment": "VoiceOver: what pressing the bar of hidden lines does."
    },
    "Taken automatically: %@": {
      "comment": "VoiceOver: a block whose sources the merge took, such as A."
    },
    "Takes no lines, as you chose": {
      "comment": "Help tag of a block that takes no lines from any input."
    },
    "Takes the lines of %@, as the merge decided": {
      "comment": "Help tag of a block whose sources the merge took, such as A and B."
    },
    "Takes the lines of %@, in the order you chose": {
      "comment": "Help tag of a block whose sources the user chose, such as B and A."
    }
  },
  "version": "1.0"
}
